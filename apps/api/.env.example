# Copia a .env.local (gitignored). En el VPS, defínelas en el entorno del servicio. ADDR, DATABASE_URL y ALLOWED_ORIGINS son obligatorias.

# Dirección de escucha; en el VPS, en localhost detrás del reverse proxy.
ADDR=127.0.0.1:8080

# URL de Postgres + PostGIS; esta es la base de datos de compose.yaml.
DATABASE_URL=postgres://civicpulse_dev:civicpulse_dev@localhost:5434/civicpulse_dev?sslmode=disable

# Orígenes del navegador que pueden llamar a la API, separados por comas.
ALLOWED_ORIGINS=http://localhost:5173

# text (dev) o json (VPS).
LOG_FORMAT=text

# Opcional. Clave de la API de ESIOS (Red Eléctrica) para generación, demanda, CO₂ y precios en tiempo real.
# Se pide en https://www.esios.ree.es (consultas@esios.ree.es). Sin ella, «Mi casa» usa REData (solo precios).
# ESIOS_TOKEN=

# Opcional. Motor de rutas local (servicio `valhalla` de compose.yaml). Sin él, las rutas salen de CartoCiudad:
# sin sentidos únicos, sin indicaciones y sin bici.
VALHALLA_URL=http://localhost:8002
