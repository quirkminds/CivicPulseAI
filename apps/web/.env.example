# Copia a .env.local (gitignored). Público: se empaqueta en el JS, nunca pongas secretos aquí.

# API de CivicPulse; comentada = datos de ejemplo (src/mocks).
# «/» = mismo origen: Vite reenvía /v1 y /healthz a la API y toda la app se ve en http://localhost:5173.
# También vale una URL absoluta (p. ej. http://localhost:8080; la API debe permitir el origen en ALLOWED_ORIGINS).
# VITE_API_URL=/

# Solo servidor de desarrollo (no llega al navegador): adónde reenvía Vite /v1 y /healthz.
# API_PROXY_TARGET=http://localhost:8080
